# Copy to .env.local. Do not paste keys into chat or commit this local file.
# No provider is selected by default. Account/CRM/knowledge work without AI keys.
VOICE_PROVIDER=none
VOICE_TRANSPORT=webrtc

# Azure Founders Hub: this project's selected paid inference route.
# VOICE_PROVIDER=azure
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_REALTIME_DEPLOYMENT=
# Existing Azure deployment used for GroupAI room replies.
AZURE_OPENAI_TEXT_DEPLOYMENT=gpt-4.1-mini
# Optional existing Foundry project endpoint for project-agent administration.
# This API key is resource/project access, not Azure subscription management.
AZURE_FOUNDRY_PROJECT_ENDPOINT=
# Optional task roles. Use existing DEPLOYMENT names, not catalog model names.
AZURE_OPENAI_FAST_DEPLOYMENT=
AZURE_OPENAI_REASONING_DEPLOYMENT=
AZURE_OPENAI_EVALUATION_DEPLOYMENT=
AI_DAILY_ORG_TOKEN_BUDGET=250000
# Optional verified per-million rates keyed by deployed model name.
AZURE_OPENAI_DEPLOYMENT_PRICES_JSON=
# AZURE_OPENAI_REALTIME_VOICE=marin
# Endpoint accepts the Azure resource origin or its /openai/v1 suffix.

# Optional adapters remain interchangeable; do not enable paid alternatives
# without changing the project's Azure-only spending decision.
# VOICE_PROVIDER=openai
OPENAI_API_KEY=
# Leave model/voice unset to use the adapter's documented defaults.
# OPENAI_REALTIME_MODEL=
# OPENAI_REALTIME_VOICE=
# VOICE_PROVIDER=gemini
# VOICE_TRANSPORT=websocket
GEMINI_API_KEY=
# GEMINI_LIVE_MODEL=
# GEMINI_LIVE_VOICE=Kore

# Maya's original Gemini Despina profile, separate from the workspace default.
# Enable only the user's approved existing free projects. No paid fallback.
MAYA_GEMINI_ENABLED=false
MAYA_GEMINI_MODEL=gemini-3.1-flash-live-preview
# Comma-separated label~key entries, retained privately on the server.
MAYA_GOOGLE_KEYS=
# Limit routing to labels verified for Live access; labels contain no keys.
MAYA_GOOGLE_ACTIVE_LABELS=

# Optional Azure Personal Voice. Approval is resource/use-case specific.
AZURE_PERSONAL_VOICE_LIMITED_ACCESS_APPROVED=false
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_PERSONAL_VOICE_PROJECT_ID=
# Optional prefill; the form requires the company name spoken in consent.
AZURE_PERSONAL_VOICE_COMPANY_NAME=
# Set only to a supported fixed voice returned by this resource's catalog.
AZURE_PERSONAL_VOICE_BASE_VOICE=

# Optional PostgreSQL / Neon connection string. Empty uses local SQLite.
DATABASE_URL=
# For local standalone preview, use an absolute path to the existing workspace database.
# Next's packaged server changes its working directory; a relative path opens another store.
# SQLITE_PATH=C:/path/to/sales-enabler/data/workspace.sqlite

# Public origin required for OAuth callbacks and production origin validation.
APP_URL=http://localhost:3000
# Generate 32 random bytes as 64 hexadecimal characters. Keep stable/backed up.
CONNECTOR_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# Explicit background worker; starting Next alone never dispatches schedules.
# Enable only when ready to execute schedules approved in Automations.
AUTOMATION_WORKER_ENABLED=0

# Public agents run through a separate, bounded Azure server gateway.
# Hosted deployments require wss://your-gateway-domain/voice.
PUBLIC_VOICE_GATEWAY_URL=ws://localhost:3001/voice
PUBLIC_VOICE_GATEWAY_HOST=127.0.0.1
PUBLIC_VOICE_GATEWAY_PORT=3001
# Optional private microphone recognition, hosted by the same gateway process.
# Hosted: wss://your-gateway-domain/private-speech. Azure Speech keys stay server-side.
CONTINUOUS_SPEECH_GATEWAY_URL=
# Local preview only: set true with ws://localhost:3001/private-speech.
# Issuance also requires a loopback browser origin; remote origins cannot use local WS.
CONTINUOUS_SPEECH_ALLOW_LOCAL_WS=false
# Generate a stable secret of at least 32 characters; never put it in NEXT_PUBLIC.
PUBLIC_SESSION_HASH_SECRET=
# Optional header overwritten by trusted ingress with the caller IP.
# Leave empty until ingress behavior is verified; callers then share a safe bucket.
PUBLIC_TRUSTED_IP_HEADER=
# Background replies/learning are disabled until explicitly enabled.
CHANNEL_WORKER_ENABLED=0
LEARNING_WORKER_ENABLED=0

# Account recovery and verification use Azure Communication Services Email,
# a separate resource from Azure OpenAI. Blank means off in development and
# on in production. Set false only for a deliberate local preview.
AUTH_REQUIRE_EMAIL_VERIFICATION=
# Generate 32 random bytes as 64 hexadecimal characters; keep stable/backed up.
AUTH_LIFECYCLE_KEY=
AZURE_COMMUNICATION_EMAIL_ENDPOINT=
AZURE_COMMUNICATION_EMAIL_ACCESS_KEY=
AZURE_COMMUNICATION_EMAIL_SENDER=
# Optional trusted ingress-overwritten IP header for auth rate limiting.
AUTH_TRUSTED_IP_HEADER=
# Development only: absolute local outbox path, localhost and NODE_ENV=development.
AUTH_DEV_MAIL_OUTBOX=
