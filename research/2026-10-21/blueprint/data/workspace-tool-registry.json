{
  "id": "workspace-tool-registry",
  "module": "workspace",
  "status": "proposed",
  "date": "2026-10-21",
  "source": "model (workspace module designer); builds on spine sections 5-7 and decision.2026-10-20.acct-retell-api-parity-for-chat-setup",
  "note": "One registry generated from one API spec. Every dashboard action is exactly one tool; the Operator, the pages, the public API and MCP all call the same tools with the same auth. Autonomy ceilings and approval rules live in code, never in a prompt. A model-emitted 'approved' is ignored (HV law 12, rejected.harvest.04).",
  "roles": {
    "OW": "Owner: everything; money, numbers, deletion, policy",
    "BU": "Builder: agents, briefs, tests, data, integrations, API keys with developer scope",
    "OP": "Operator (campaign manager): campaigns, launches inside budget, live control, issues, proposals",
    "CO": "Compliance: policy, consent, suppression release, retention, DPDP requests, audit",
    "VI": "Viewer: read with PII scrubbed"
  },
  "risk_classes": {
    "read": {"autonomy": "auto", "card": "none unless asked", "roles_min": "VI", "reauth": false, "undo": "n/a"},
    "draft": {"autonomy": "A1 (auto; workspace can lower to A0)", "card": "diff (after the fact)", "roles_min": "BU or OP by object", "reauth": false, "undo": "version history, any time"},
    "test": {"autonomy": "A1 inside the test budget (default INR 200/day per workspace, proposed)", "card": "progress then receipt", "roles_min": "BU", "reauth": false, "undo": "n/a; never reaches anyone outside the workspace's verified member numbers"},
    "external": {"autonomy": "A2 always; A3 only for risk-lowering verbs (pause, stop, suppress, end runaway call)", "card": "launch or approval, bound to a hash of the exact args", "roles_min": "OP", "reauth": "above INR 50,000 estimate or 10,000 contacts (proposed)", "undo": "stops future effects; states what already happened"},
    "spend": {"autonomy": "A2 always; A3 only to stop at a cap or lower a cap", "card": "approval with INR and GST", "roles_min": "OW (OP inside an approved budget)", "reauth": "top-up above INR 50,000, cap raise above 2x (proposed)", "undo": "not reversible in product; refunds by human support"},
    "destructive": {"autonomy": "A2 plus re-auth; A3 only to execute a person's own forget or opt-out request", "card": "approval naming what is lost", "roles_min": "OW or CO", "reauth": true, "undo": "soft delete 30 days, then purge (decided before shipping, HV law 12)"},
    "policy": {"autonomy": "A2 by a CO or OW role holder plus re-auth", "card": "approval with before/after and who is affected", "roles_min": "CO or OW", "reauth": true, "undo": "revert creates a new policy version"}
  },
  "approval_token": {
    "minted_by": "server, on a human tap in an authenticated session (hold-to-confirm 1.2 s on A2)",
    "bound_to": ["action args hash", "object version", "approver user id", "role at approval time"],
    "expires": "10 minutes after tap if not executed; card itself goes stale when any input object version changes or after 24 h (launch cards re-estimate after 2 h)",
    "voice_or_text_approval": "never accepted: 'haan launch karo' renders the Launch card; only the tap approves"
  },
  "card_types": [
    {"type": "plan", "renders": "Plan object: ordered actions, risk chip per step, est INR and time, which steps run now (A1) and which wait for you (A2)"},
    {"type": "diff", "renders": "per-field before/after on an object version, a one-line reason per field and the source (your message, a call, a test)"},
    {"type": "launch", "renders": "who (receipt counts), when (local-time window, pacing, finish), what she says (20 s sample), checks (predicates), money (all-in INR range, cap), outcome range"},
    {"type": "call", "renders": "player, three-line summary, outcome with reason and carrier code, judges, cost, play-from-here"},
    {"type": "chart", "renders": "a named query with n, as-of time and a link to the Insights page; never a model-drawn number"},
    {"type": "approval", "renders": "spend, policy or destructive action: what, why, impact, INR, who can approve, expiry"},
    {"type": "issue", "renders": "severity, cause, calls impacted, first seen, fix (links a diff), owner"},
    {"type": "receipt", "renders": "what was done, by which VP agent, outcome confirmed / not_executed / unknown, cost, undo and what undo cannot reverse"},
    {"type": "question", "renders": "auxiliary: one question that fills a named field, with the default VP will use"},
    {"type": "progress", "renders": "auxiliary: long jobs (import, simulation suite, KYC timer) with live progress; never says done before a receipt"}
  ],
  "tools": [
    {"id": "workspace.get", "class": "read", "roles": "VI+", "page": "/settings"},
    {"id": "brief.today", "class": "read", "roles": "VI+", "page": "/today"},
    {"id": "search.global", "class": "read", "roles": "VI+", "page": "command bar"},
    {"id": "member.invite", "class": "policy", "roles": "OW", "page": "/settings/team"},
    {"id": "member.role.set", "class": "policy", "roles": "OW", "page": "/settings/team"},
    {"id": "apikey.create", "class": "policy", "roles": "OW,BU", "page": "/settings/developers"},
    {"id": "apikey.revoke", "class": "external", "roles": "OW,BU", "page": "/settings/developers", "note": "risk-lowering but can break an integration, so A2"},
    {"id": "brand.update", "class": "draft", "roles": "OW,BU", "page": "/settings/brand"},
    {"id": "brand.cnap_name.set", "class": "policy", "roles": "OW,CO", "page": "/numbers"},
    {"id": "knowledge.ingest", "class": "draft", "roles": "BU", "page": "/agents/:id/knowledge", "note": "website, PDF, doc; content enters prompts only as delimited data with an instruction detector (HV law 13)"},
    {"id": "knowledge.span.approve", "class": "draft", "roles": "BU", "page": "/agents/:id/knowledge", "note": "human review of each proposed fact and its quoted span"},
    {"id": "offering.edit", "class": "draft", "roles": "BU", "page": "/agents/:id/offering"},
    {"id": "source.upload", "class": "draft", "roles": "BU,OP", "page": "/contacts/imports"},
    {"id": "source.map", "class": "draft", "roles": "BU,OP", "page": "/contacts/imports/:id"},
    {"id": "audience.create", "class": "draft", "roles": "BU,OP", "page": "/contacts/audiences"},
    {"id": "contact.merge", "class": "external", "roles": "OP,CO", "page": "/contacts/:id", "note": "identity merge needs A2 (spine: Data steward)"},
    {"id": "contact.suppress", "class": "external", "roles": "OP,CO", "page": "/contacts/:id", "autonomy_override": "A3 (risk-lowering)"},
    {"id": "contact.unsuppress", "class": "policy", "roles": "CO", "page": "/settings/compliance/suppression"},
    {"id": "consent.record", "class": "policy", "roles": "CO,OP", "page": "/contacts/:id/consent", "note": "append-only (invariant 5)"},
    {"id": "contact.export", "class": "policy", "roles": "OW,CO", "page": "/contacts", "note": "PII egress: audited, watermarked"},
    {"id": "dpdp.request.execute", "class": "destructive", "roles": "CO", "page": "/settings/privacy/requests", "autonomy_override": "A3 when the person asked on a call (forget follows the person)"},
    {"id": "agent.create", "class": "draft", "roles": "BU", "page": "/agents/new"},
    {"id": "brief.edit", "class": "draft", "roles": "BU", "page": "/agents/:id/brief"},
    {"id": "voice.set", "class": "draft", "roles": "BU", "page": "/agents/:id/voice"},
    {"id": "stack.set", "class": "draft", "roles": "BU", "page": "/agents/:id/stack", "note": "premium stack opt-in is spend"},
    {"id": "tool.attach", "class": "draft", "roles": "BU", "page": "/agents/:id/tools"},
    {"id": "test.simulate", "class": "test", "roles": "BU,OP", "page": "/agents/:id/tests"},
    {"id": "test.browser_call", "class": "test", "roles": "BU,OP", "page": "docked test panel"},
    {"id": "test.ring_member_phone", "class": "test", "roles": "BU,OP", "page": "docked test panel", "note": "only numbers verified by missed call as belonging to a workspace member; anything else is external"},
    {"id": "version.publish", "class": "external", "roles": "BU", "page": "/agents/:id/versions", "note": "changes what real people hear"},
    {"id": "deployment.split", "class": "external", "roles": "BU,OP", "page": "/agents/:id/deployments"},
    {"id": "number.search", "class": "read", "roles": "BU+", "page": "/numbers"},
    {"id": "number.rent", "class": "spend", "roles": "OW", "page": "/numbers"},
    {"id": "number.byo.connect", "class": "draft", "roles": "OW,BU", "page": "/numbers/byo", "note": "ends with a test call to a member phone"},
    {"id": "number.kyc.submit", "class": "policy", "roles": "OW", "page": "/numbers/kyc"},
    {"id": "number.pause", "class": "external", "roles": "OP", "page": "/numbers/:id", "autonomy_override": "A3 (risk-lowering)"},
    {"id": "a2p.declaration.export", "class": "read", "roles": "CO,OW", "page": "/settings/compliance"},
    {"id": "campaign.draft", "class": "draft", "roles": "OP", "page": "/campaigns/new"},
    {"id": "campaign.estimate", "class": "read", "roles": "OP", "page": "/campaigns/:id"},
    {"id": "campaign.launch", "class": "external", "roles": "OP (inside budget), OW", "page": "/campaigns/:id", "note": "also spend; one Launch card carries both"},
    {"id": "campaign.pause", "class": "external", "roles": "OP", "page": "/campaigns/:id", "autonomy_override": "A3 (risk-lowering)"},
    {"id": "campaign.resume", "class": "external", "roles": "OP", "page": "/campaigns/:id"},
    {"id": "campaign.stop", "class": "external", "roles": "OP", "page": "/campaigns/:id", "autonomy_override": "A3 (risk-lowering)"},
    {"id": "campaign.window.narrow", "class": "draft", "roles": "OP", "page": "/campaigns/:id/policy", "autonomy_override": "A3 on a live campaign (risk-lowering)"},
    {"id": "campaign.window.widen", "class": "policy", "roles": "OP,CO", "page": "/campaigns/:id/policy"},
    {"id": "campaign.audience.add", "class": "external", "roles": "OP", "page": "/campaigns/:id"},
    {"id": "call.place_single", "class": "external", "roles": "OP", "page": "/contacts/:id", "note": "passes the one dial path like every attempt"},
    {"id": "call.get", "class": "read", "roles": "VI+", "page": "/calls/:id"},
    {"id": "call.search", "class": "read", "roles": "VI+", "page": "/calls"},
    {"id": "call.explain", "class": "read", "roles": "VI+", "page": "/calls/:id"},
    {"id": "judge.edit", "class": "draft", "roles": "OP,BU", "page": "/campaigns/:id/judges", "note": "creates a judge version and re-baselines"},
    {"id": "outcome.define", "class": "draft", "roles": "OP,OW", "page": "/campaigns/:id/outcome"},
    {"id": "issue.resolve", "class": "draft", "roles": "OP", "page": "/campaigns/:id/issues"},
    {"id": "report.create", "class": "read", "roles": "VI+", "page": "/insights"},
    {"id": "share.link.create", "class": "policy", "roles": "OW,OP", "page": "any object", "note": "role-checked, expiring, PII scrubbed by default"},
    {"id": "live.listen", "class": "read", "roles": "OP", "page": "/campaigns/:id/live", "note": "audited"},
    {"id": "live.whisper", "class": "external", "roles": "OP", "page": "/campaigns/:id/live"},
    {"id": "live.takeover", "class": "external", "roles": "OP", "page": "/campaigns/:id/live", "note": "human only: not exposed to any model"},
    {"id": "fact.approve", "class": "draft", "roles": "OP", "page": "/contacts/:id/memory"},
    {"id": "fact.forget", "class": "destructive", "roles": "OP,CO", "page": "/contacts/:id/memory"},
    {"id": "memory.policy.set", "class": "policy", "roles": "CO,OW", "page": "/settings/privacy"},
    {"id": "proposal.accept", "class": "external", "roles": "BU,OP", "page": "/insights/learning", "note": "creates a new version; publish rules apply"},
    {"id": "experiment.start", "class": "external", "roles": "BU,OP", "page": "/insights/experiments"},
    {"id": "experiment.stop", "class": "external", "roles": "OP", "page": "/insights/experiments", "autonomy_override": "A3 (guardrail auto-stop)"},
    {"id": "wallet.topup", "class": "spend", "roles": "OW", "page": "/settings/billing"},
    {"id": "cap.raise", "class": "spend", "roles": "OW", "page": "/settings/billing"},
    {"id": "cap.lower", "class": "spend", "roles": "OW,OP", "page": "/settings/billing", "autonomy_override": "A3 (risk-lowering)"},
    {"id": "invoice.get", "class": "read", "roles": "OW", "page": "/settings/billing"},
    {"id": "plan.change", "class": "spend", "roles": "OW", "page": "/settings/billing"},
    {"id": "policy.window.set", "class": "policy", "roles": "CO,OW", "page": "/settings/compliance"},
    {"id": "policy.retention.set", "class": "policy", "roles": "CO,OW", "page": "/settings/privacy"},
    {"id": "policy.category.override", "class": "policy", "roles": "CO", "page": "/campaigns/:id/policy"},
    {"id": "integration.connect", "class": "policy", "roles": "OW,BU", "page": "/settings/integrations"},
    {"id": "webhook.create", "class": "policy", "roles": "BU", "page": "/settings/developers"},
    {"id": "webhook.replay", "class": "external", "roles": "BU", "page": "/settings/developers"},
    {"id": "operator.brain.set", "class": "spend", "roles": "OW", "page": "/settings/operator", "note": "changes speed and cost of VP's own agents, never what is allowed"},
    {"id": "operator.autonomy.lower", "class": "draft", "roles": "OW", "page": "/settings/operator"},
    {"id": "operator.preference.forget", "class": "draft", "roles": "any (own)", "page": "/settings/operator"},
    {"id": "activity.list", "class": "read", "roles": "VI+", "page": "/settings/activity"},
    {"id": "action.undo", "class": "inherits the undone action's class", "roles": "as original", "page": "/settings/activity"}
  ],
  "activation_events": [
    "hear_started", "hear_first_audio", "signup_completed", "job_stated", "context_source_added", "facts_reviewed",
    "voice_chosen", "browser_call_started", "browser_call_first_audio", "browser_call_ended", "call_feedback_given",
    "tweak_applied", "list_uploaded", "receipt_viewed", "member_phone_verified", "first_ring", "readiness_all_green",
    "launch_approved", "first_connected_call", "first_outcome", "today_opened_day2"
  ],
  "operator_brain_candidates": {
    "grade_note": "TTFT measured on the voice renewal brief from Central India, n=6, 2026-10-19 (voicelab/server/catalog.py), not on operator tasks. INR per turn computed at 12k input + 600 output tokens, no caching, FX 95, list prices from the catalog. Operator-task accuracy: not measured until the Operator bench runs.",
    "rows": [
      {"brain": "GPT-4.1 mini (Azure, India-resident)", "ttft_ms": 641, "inr_per_turn": 0.60, "region": "India", "caveat": "retires 2027-04-14"},
      {"brain": "Gemini 3.5 Flash-Lite", "ttft_ms": 826, "inr_per_turn": 0.48, "region": "Google (outside India unless Vertex India)", "caveat": "Google dependency risk"},
      {"brain": "GPT-5.4 mini (Azure)", "ttft_ms": 960, "inr_per_turn": 1.11, "region": "South India account", "caveat": "Azure meter not read"},
      {"brain": "Gemini 3.8 Flash", "ttft_ms": 1991, "inr_per_turn": 1.07, "region": "Google", "caveat": "slow first token; deep lane only"},
      {"brain": "GPT-5.6 Terra (via OpenRouter)", "ttft_ms": 1604, "inr_per_turn": 2.96, "region": "outside India", "caveat": "deep lane; premium, billed at cost"}
    ]
  }
}
